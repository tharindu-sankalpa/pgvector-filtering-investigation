# Local diagnostics use port-forwarded endpoints. Do not commit real passwords.
AWS_DEFAULT_REGION=ap-south-1
EKS_CLUSTER=pgvector-investigation
ECR_REGISTRY=<account-id>.dkr.ecr.ap-south-1.amazonaws.com
DATASET_BUCKET=<dataset-bucket>
PG_HOST=127.0.0.1
PG_PORT=15432
PG_USER=benchmark_user
PG_PASSWORD=
VECTOR_PG_DATABASE=benchmark_vectors
CNPG_PG_HOST=127.0.0.1
CNPG_PG_PORT=15432
CNPG_PG_USER=benchmark_user
CNPG_PG_PASSWORD=
RESULTS_PG_HOST=127.0.0.1
RESULTS_PG_PORT=15433
RESULTS_PG_USER=results_user
RESULTS_PG_PASSWORD=
RESULTS_PG_DATABASE=benchmark_results
PGSSLMODE=require
TABLE_NAME=wot_chunks_2_5m
DATA_FILE=/app/data/gen_wot_2.5m.parquet
QUERY_FILE=/app/data/wot_retrieval_queries.parquet
BENCHMARK_NUM_QUERIES=4373
WARMUP_QUERIES=50
CONCURRENCY_LEVELS=1,2,4,8,16,32,50,100
TOP_K_VALUES=1,5,10,20,50,100
